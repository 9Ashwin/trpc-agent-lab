# DeepSeek API Key（必填）
DEEPSEEK_API_KEY=

# 模型名：deepseek-v4-flash（便宜快）/ deepseek-v4-pro（更强推理）
MODEL=deepseek-v4-pro

# 监听地址与 AG-UI 路径
ADDRESS=127.0.0.1:8080
AGUI_PATH=/agui

# 数据目录（SQLite 会话库 + 记忆库）
DATA_DIR=./data

# Agent Skills 目录
SKILLS_DIR=./skills

# 隔离 workspace（代码执行工作区）
WORKSPACE_DIR=./data/workspace

# 多 agent team（coordinator + 专家成员），true 开启 / false 用单 agent
TEAM_MODE=true

# 外部 MCP server 配置
MCP_SERVERS_FILE=./mcp_servers.json

# RAG 知识库（默认关闭，需配置 embedding 端点）
KNOWLEDGE_ENABLED=false
EMBEDDER_MODEL=
EMBEDDER_API_KEY=
EMBEDDER_BASE_URL=
KNOWLEDGE_DIR=./knowledge
